# Audiobook Generator Configuration

# Ollama model for QA agents (conversion QA, chapter QA, audio QA)
# Note: Thinking models (with <think> tags) are supported - output is parsed automatically
OLLAMA_MODEL=qwen3:235b-a22b-thinking-2507-fp16

# Ollama base URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama context window size (num_ctx) - increase for longer text analysis
# Default for most models is 2048, but for book analysis we need more
OLLAMA_NUM_CTX=32768

# Ollama max tokens to generate in response
OLLAMA_NUM_PREDICT=2048

# TTS voice (Ryan, Aiden, Vivian, Serena)
TTS_VOICE=Ryan

# TTS language
TTS_LANGUAGE=English

# Maximum characters per TTS chunk (300-800 recommended)
TTS_CHUNK_SIZE=1000

# Maximum QA retry attempts
MAX_QA_ATTEMPTS=4
